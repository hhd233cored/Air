CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://airchord.org,https://www.airchord.org,https://air-89d.pages.dev
SERVER_PORT=8080
AUTH_ENABLED=true
AUTH_DATABASE_PATH=./backend-python/data/auth.sqlite3
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-this-password
AUTH_USER_USERNAME=reader
AUTH_USER_PASSWORD=change-this-password
AUTH_SESSION_TIMEOUT=7d
AUTH_COOKIE_NAME=air_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_CSRF_ENABLED=true
AUTH_REGISTRATION_ENABLED=true
AUTH_AVATAR_MAX_BYTES=2097152
# Python 后端限流（单进程内存滑动窗口，不写入 SQLite）
# 是否启用 Python 后端内存限流
RATE_LIMIT_ENABLED=true
# 当前进程最多保留的限流键数量
RATE_LIMIT_MAX_KEYS=10000
# 单个客户端 IP 允许的登录次数
RATE_LIMIT_LOGIN_IP_MAX=5
# 登录 IP 限制时间窗口
RATE_LIMIT_LOGIN_IP_WINDOW=60s
# 同一用户名允许的登录次数
RATE_LIMIT_LOGIN_USERNAME_MAX=10
# 登录用户名限制时间窗口
RATE_LIMIT_LOGIN_USERNAME_WINDOW=10m
# 单个客户端 IP 允许的注册次数
RATE_LIMIT_REGISTER_IP_MAX=3
# 注册 IP 限制时间窗口
RATE_LIMIT_REGISTER_IP_WINDOW=1h
# 单个客户端 IP 允许的文章/说说评论次数
RATE_LIMIT_COMMENT_IP_MAX=20
# 评论 IP 限制时间窗口
RATE_LIMIT_COMMENT_IP_WINDOW=60s
# 单个用户允许的文章/说说评论次数
RATE_LIMIT_COMMENT_USER_MAX=10
# 评论用户限制时间窗口
RATE_LIMIT_COMMENT_USER_WINDOW=60s
# 单个客户端 IP 允许的留言次数
RATE_LIMIT_GUESTBOOK_IP_MAX=10
# 留言 IP 限制时间窗口
RATE_LIMIT_GUESTBOOK_IP_WINDOW=1h
# 单个用户允许的留言次数
RATE_LIMIT_GUESTBOOK_USER_MAX=3
# 留言用户限制时间窗口
RATE_LIMIT_GUESTBOOK_USER_WINDOW=1h
# 单个用户允许更换头像的次数
RATE_LIMIT_AVATAR_USER_MAX=5
# 更换头像限制时间窗口
RATE_LIMIT_AVATAR_USER_WINDOW=1h
# 管理员/编辑器写操作允许次数
RATE_LIMIT_ADMIN_MAX=60
# 管理员/编辑器限制时间窗口
RATE_LIMIT_ADMIN_WINDOW=60s
# 单个客户端 IP 允许获取 CSRF Token 和发起受保护写请求的次数
RATE_LIMIT_CSRF_IP_MAX=30
# CSRF 限制时间窗口
RATE_LIMIT_CSRF_IP_WINDOW=60s
# 只有后端前面是受信任的 Nginx/反向代理时才开启；不要直接信任客户端提交的请求头
# 仅当直接连接方位于 TRUSTED_PROXY_IPS 中时，才信任代理 IP 请求头
RATE_LIMIT_TRUST_PROXY_HEADERS=false
# 允许提供客户端 IP 请求头的反向代理地址，多个地址用逗号分隔
TRUSTED_PROXY_IPS=127.0.0.1
COMMENTS_ENABLED=true
COMMENTS_MAX_LENGTH=1000
# 内容存储方式：files 读取 public 下的 Markdown；database 使用共享 SQLite 内容表
CONTENT_STORAGE=files
# 前端回退模式必须与后端保持一致；database 模式下 API 失败不会读取 Markdown 文件
NEXT_PUBLIC_CONTENT_STORAGE=files
EDITOR_ENABLED=false
# 编辑器已经整合到主后端，使用 SERVER_PORT；无需单独配置编辑器端口。
SERVER_TOMCAT_THREADS_MAX=16
SERVER_TOMCAT_MAX_CONNECTIONS=64
SERVER_TOMCAT_ACCEPT_COUNT=32
ARTICLE_CONTENT_DIR=./public/articles
CHATTER_CONTENT_DIR=./public/chatter
MUSIC_SOURCE=local
MUSIC_CONTENT_DIR=./music
# 管理员单次上传音乐的大小上限，默认 50 MiB
MUSIC_MAX_UPLOAD_BYTES=52428800
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_EDITOR_ENABLED=false
NEXT_PUBLIC_MAINTENANCE_MODE=true
WIKIPEDIA_ON_THIS_DAY_URL=https://api.wikimedia.org/feed/v1/wikipedia/zh/onthisday/all
NETEASE_MUSIC_API_BASE_URL=https://openapi.music.163.com
NETEASE_MUSIC_PLAYLIST_ID=17434435787
NETEASE_MUSIC_APP_ID=
NETEASE_MUSIC_SIGN_TYPE=RSA_SHA256
# 留空时，后端会使用匿名游客登录接口获取 token；也可以直接填写已获取的 token
NETEASE_MUSIC_ACCESS_TOKEN=
NETEASE_MUSIC_APP_SECRET=
NETEASE_MUSIC_DEVICE_JSON={"deviceType":"web","os":"web","appVer":"1.0","channel":"personal-site","model":"browser","deviceId":"air"}
# 可选：128、320、999、1999；留空则使用用户可收听的最高音质
NETEASE_MUSIC_BITRATE=
