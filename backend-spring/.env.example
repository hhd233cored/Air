# 复制为 .env 后用于本机 Docker Compose 与 Spring Boot。
# 以下凭据只用于本地学习数据库，不要用于任何共享或生产环境。
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/air_spring_dev
SPRING_DATASOURCE_USERNAME=airchord_local
SPRING_DATASOURCE_PASSWORD=change-this-local-only-password
POSTGRES_HOST_PORT=5433

# 本地 Redis 仅绑定回环地址，用于公开接口缓存；缓存数据可随容器重建。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_TIMEOUT=1s

# RabbitMQ 只供 Java 音频导入任务使用；管理界面默认只监听本机 15672。
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_USERNAME=airchord_local
RABBITMQ_PASSWORD=change-this-rabbitmq-local-only-password

# 首次启动时可选地创建本地管理员/普通账号；请换成仅用于本机的密码。
# 若保持注释，应用不会创建可登录的账号；demo-admin/demo-reader 仍是无效密码夹具。
# AUTH_ADMIN_USERNAME=local-admin
# AUTH_ADMIN_PASSWORD=change-this-local-only-password
# AUTH_USER_USERNAME=local-reader
# AUTH_USER_PASSWORD=change-this-local-only-password
AUTH_REGISTRATION_ENABLED=true
AUTH_SESSION_TIMEOUT=7d
AUTH_COOKIE_NAME=air_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_AVATAR_MAX_BYTES=2097152
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://airchord.org,https://www.airchord.org,https://air-89d.pages.dev
WIKIPEDIA_ON_THIS_DAY_URL=https://api.wikimedia.org/feed/v1/wikipedia/zh/onthisday/all
WIKIPEDIA_TIME_ZONE=Asia/Shanghai

# 内容资源路径相对于 backend-spring/；阶段 5 编辑器会写 Markdown/JSON 备份及媒体。
ARTICLE_CONTENT_DIR=../public/articles
ARTICLE_METRIC_CONSUMER_BATCH_SIZE=100
ARTICLE_METRIC_PUBLISHER_MAX_BATCHES=1
ARTICLE_METRIC_PUBLISHER_RUN_BUDGET_MS=250
ARTICLE_METRIC_CONSUMER_BATCH_WAIT_MS=100
CHATTER_CONTENT_DIR=../public/chatter
MUSIC_CONTENT_DIR=../music
MUSIC_SOURCE=local
MUSIC_MAX_UPLOAD_BYTES=52428800
MUSIC_IMPORT_STAGING_DIR=../.airchord-import-staging
MUSIC_IMPORT_MAX_JOBS=20
MUSIC_IMPORT_MAX_STAGING_BYTES=1073741824

# 阶段 4：互动与首版单进程内存限流。
COMMENTS_ENABLED=true
COMMENTS_MAX_LENGTH=1000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=127.0.0.1
RATE_LIMIT_LOGIN_IP_MAX=5
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_USERNAME_MAX=10
RATE_LIMIT_LOGIN_USERNAME_WINDOW_SECONDS=600
RATE_LIMIT_REGISTER_IP_MAX=3
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=3600
RATE_LIMIT_COMMENT_IP_MAX=20
RATE_LIMIT_COMMENT_IP_WINDOW_SECONDS=60
RATE_LIMIT_COMMENT_USER_MAX=10
RATE_LIMIT_COMMENT_USER_WINDOW_SECONDS=60
RATE_LIMIT_GUESTBOOK_IP_MAX=10
RATE_LIMIT_GUESTBOOK_IP_WINDOW_SECONDS=3600
RATE_LIMIT_GUESTBOOK_USER_MAX=3
RATE_LIMIT_GUESTBOOK_USER_WINDOW_SECONDS=3600
RATE_LIMIT_AVATAR_USER_MAX=5
RATE_LIMIT_AVATAR_USER_WINDOW_SECONDS=3600
RATE_LIMIT_ADMIN_MAX=60
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60
RATE_LIMIT_CSRF_IP_MAX=30
RATE_LIMIT_CSRF_IP_WINDOW_SECONDS=60

# 编辑器默认关闭；启用后仅管理员可访问，单次 multipart 请求合计最多 100 MiB。
EDITOR_ENABLED=false
EDITOR_UPLOAD_MAX_BYTES=104857600
